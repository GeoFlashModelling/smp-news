{
  "name": "smp-news",
  "version": "0.1.0",
  "description": "S.M.P. News: free Australian news that shows what independent sources across the political spectrum agree on.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "edition": "tsx src/edition.ts",
    "typecheck": "tsc --noEmit",
    "validate-config": "tsx src/tools/validate-config.ts",
    "check-feeds": "tsx src/tools/check-feeds.ts",
    "check-terms": "tsx src/tools/check-terms.ts",
    "snapshot": "tsx src/tools/snapshot.ts",
    "cluster-report": "tsx src/tools/cluster-report.ts",
    "cluster-eval": "tsx src/tools/cluster-eval.ts",
    "ai-test": "tsx src/tools/ai-test.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2"
  }
}
